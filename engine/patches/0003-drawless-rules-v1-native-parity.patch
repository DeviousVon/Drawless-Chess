From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Drawless Chess <engine@drawless.invalid>
Date: Wed, 29 Jul 2026 00:30:00 -0500
Subject: [PATCH] Add native RulesContractV1 parity patch v2

Model the selectable bare-king, known-dead-position, and 50-move
policies at every searched node. Preserve the app's terminal precedence,
material tie breakers, and full-legal-set forced-move exception.
---
 src/position.cpp  | 145 +++++++++++++++++++++++++++++++++++++++++++++++++++++-
 src/position.h    |  10 ++++
 src/search.cpp    |   1 +
 src/ucioption.cpp |   8 ++-
 4 files changed, 162 insertions(+), 2 deletions(-)

diff --git a/src/position.cpp b/src/position.cpp
index 16d1fee55d34136289f88a99371282abce355d2f..d49199cb670a8f2e61528dcd9b24d065424f3fd7 100644
--- a/src/position.cpp
+++ b/src/position.cpp
@@ -1547,6 +1547,16 @@ void Position::do_move(Move m, StateInfo& newSt, bool givesCheck) {
   assert(is_ok(m));
   assert(&newSt != st);
 
+  // The app's forced 50-move exception is a property of the complete legal
+  // move set in the parent position. Compute it before changing the board and
+  // carry the answer into the child StateInfo where adjudication occurs.
+  const bool drawlessFiftyForced =
+      uses_drawless_rules_v1()
+      && st->rule50 >= 99
+      && (Options["Drawless Fifty Move"] == "forced-move-exception"
+          || Options["Drawless Fifty Move"] == "material-victory")
+      && !has_drawless_fifty_avoiding_move();
+
 #ifndef NO_THREADS
   thisThread->nodes.fetch_add(1, std::memory_order_relaxed);
 #endif
@@ -1559,6 +1569,7 @@ void Position::do_move(Move m, StateInfo& newSt, bool givesCheck) {
   newSt.previous = st;
   st = &newSt;
   st->move = m;
+  st->drawlessFiftyForced = drawlessFiftyForced;
 
   // Increment ply counters. In particular, rule50 will be reset to zero later on
   // in case of a capture or a pawn move.
@@ -2319,6 +2330,7 @@ void Position::do_null_move(StateInfo& newSt) {
 
   newSt.previous = st;
   st = &newSt;
+  st->drawlessFiftyForced = false;
 
   st->dirtyPiece.dirty_num = 0;
   st->dirtyPiece.piece[0] = NO_PIECE; // Avoid checks in UpdateAccumulator()
@@ -2620,8 +2632,28 @@ bool Position::see_ge(Move m, Value threshold) const {
 
 bool Position::is_optional_game_end(Value& result, int ply, int countStarted) const {
 
+  const bool drawlessRules = uses_drawless_rules_v1();
+  const bool drawlessBareKing =
+      drawlessRules
+      && Options["Drawless Bare King"] == "bare-king-loses"
+      && ((drawless_material(WHITE) == 0 && drawless_material(BLACK) > 0)
+          || (drawless_material(BLACK) == 0 && drawless_material(WHITE) > 0));
+  const bool drawlessDead = drawlessRules && drawless_known_dead_position();
+  const bool drawlessFifty =
+      drawlessRules
+      && st->rule50 >= 100
+      && Options["Drawless Fifty Move"] != "disabled";
+
+  // Checkmate and stalemate have absolute precedence in RulesContractV1.
+  // Defer all otherwise-applicable optional outcomes until the ordinary
+  // no-legal-move path has assigned the configured mate/stalemate result.
+  if (   drawlessRules
+      && (completes_drawless_repetition() || drawlessBareKing || drawlessDead || drawlessFifty)
+      && !MoveList<LEGAL>(*this).size())
+      return false;
+
   // n-move rule
-  if (n_move_rule() && st->rule50 > (2 * n_move_rule() - 1) && (!checkers() || MoveList<LEGAL>(*this).size()))
+  if (!drawlessRules && n_move_rule() && st->rule50 > (2 * n_move_rule() - 1) && (!checkers() || MoveList<LEGAL>(*this).size()))
   {
       int offset = 0;
       if (var->chasingRule == AXF_CHASING && st->pliesFromNull >= 20)
@@ -2727,6 +2759,55 @@ bool Position::is_optional_game_end(Value& result, int ply, int countStarted) co
       }
   }
 
+  // Drawless policy precedence after repetition is bare king, known-dead
+  // position, then the configured 50-move outcome. Values are always relative
+  // to the side to move, matching Fairy-Stockfish's search convention.
+  if (drawlessBareKing)
+  {
+      const Color winner = drawless_material(WHITE) == 0 ? BLACK : WHITE;
+      result = winner == sideToMove ? mate_in(ply) : mated_in(ply);
+      return true;
+  }
+
+  if (drawlessDead)
+  {
+      Color winner;
+      if (Options["Drawless Dead Position"] == "final-capture-victory")
+          winner = ~sideToMove;
+      else
+      {
+          const int whiteMaterial = drawless_material(WHITE);
+          const int blackMaterial = drawless_material(BLACK);
+          winner = whiteMaterial > blackMaterial ? WHITE
+                 : blackMaterial > whiteMaterial ? BLACK
+                                                 : ~sideToMove;
+      }
+      result = winner == sideToMove ? mate_in(ply) : mated_in(ply);
+      return true;
+  }
+
+  if (drawlessFifty)
+  {
+      Color winner;
+      if (Options["Drawless Fifty Move"] == "completing-player-loses")
+          winner = sideToMove;
+      else if (Options["Drawless Fifty Move"] == "forced-move-exception")
+          winner = st->drawlessFiftyForced ? ~sideToMove : sideToMove;
+      else
+      {
+          const int whiteMaterial = drawless_material(WHITE);
+          const int blackMaterial = drawless_material(BLACK);
+          const Color lastCaptureBy = drawless_last_capture_by();
+          winner = whiteMaterial > blackMaterial ? WHITE
+                 : blackMaterial > whiteMaterial ? BLACK
+                 : lastCaptureBy != COLOR_NB       ? lastCaptureBy
+                 : st->drawlessFiftyForced         ? ~sideToMove
+                                                   : sideToMove;
+      }
+      result = winner == sideToMove ? mate_in(ply) : mated_in(ply);
+      return true;
+  }
+
   // counting rules
   if (   counting_rule()
       && st->countingLimit
@@ -3115,6 +3196,68 @@ bool Position::has_repeated() const {
 }
 
 
+/// Position::has_drawless_fifty_avoiding_move() checks the complete legal move
+/// set for a capture or pawn move that resets the standard halfmove clock.
+
+bool Position::has_drawless_fifty_avoiding_move() const {
+
+  for (Move move : MoveList<LEGAL>(*this))
+      if (   type_of(moved_piece(move)) == PAWN
+          || type_of(move) == EN_PASSANT
+          || (type_of(move) != CASTLING && piece_on(to_sq(move)) != NO_PIECE))
+          return true;
+
+  return false;
+}
+
+
+/// Position::drawless_known_dead_position() mirrors the deliberately
+/// conservative RulesContractV1 detector: bare kings, exactly one non-king
+/// minor, or bishops only with every bishop on the same square color.
+
+bool Position::drawless_known_dead_position() const {
+
+  if (count<PAWN>() || count<ROOK>() || count<QUEEN>())
+      return false;
+
+  const int bishops = count<BISHOP>();
+  const int knights = count<KNIGHT>();
+  const int nonKings = bishops + knights;
+
+  if (nonKings <= 1)
+      return true;
+
+  const Bitboard bishopSquares = pieces(BISHOP);
+  return knights == 0
+      && (!(bishopSquares & DarkSquares) || !(bishopSquares & ~DarkSquares));
+}
+
+
+/// Position::drawless_material() uses the immutable RulesContractV1 weights.
+
+int Position::drawless_material(Color c) const {
+  return count<PAWN>(c)
+       + 3 * (count<KNIGHT>(c) + count<BISHOP>(c))
+       + 5 * count<ROOK>(c)
+       + 9 * count<QUEEN>(c);
+}
+
+
+/// Position::drawless_last_capture_by() derives the last capturer from the
+/// real move history. A standalone FEN has no predecessor, matching the app's
+/// null lastCaptureBy value for a nonstandard initial position.
+
+Color Position::drawless_last_capture_by() const {
+
+  Color mover = ~sideToMove;
+  for (const StateInfo* stp = st; stp && stp->previous; stp = stp->previous, mover = ~mover)
+      if (stp->capturedPiece)
+          return mover;
+
+  return COLOR_NB;
+}
+
+
 /// Position::all_legal_moves_complete_drawless_repetition() determines the
 /// forced branch of the Drawless repetition rule before search pruning can
 /// discard siblings. The complete LEGAL list is required: pseudo-legal moves
