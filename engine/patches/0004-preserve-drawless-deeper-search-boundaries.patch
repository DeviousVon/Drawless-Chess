+/// Position::drawless_fifty_boundary() marks nodes where the next quiet
+/// non-pawn move reaches the enabled RulesContractV1 100-halfmove terminal.
+
+bool Position::drawless_fifty_boundary() const {
+  return uses_drawless_rules_v1()
+      && st->rule50 >= 99
+      && Options["Drawless Fifty Move"] != "disabled";
+}
+
+
+/// Position::normalize_drawless_ep() removes pseudo-only en-passant targets
+/// from RulesContractV1 state and its repetition key. The app records an EP
+/// right only when at least one legal en-passant capture exists; in particular,
+/// a pawn pinned to its king must not make an otherwise identical board hash as
+/// a different position.
+
+void Position::normalize_drawless_ep() {
+  if (!uses_drawless_rules_v1() || !st->epSquares)
+      return;
+
+  Bitboard legalEpSquares = 0;
+  for (Move move : MoveList<LEGAL>(*this))
+      if (type_of(move) == EN_PASSANT)
+          legalEpSquares |= to_sq(move);
+
+  Bitboard invalidEpSquares = st->epSquares & ~legalEpSquares;
+  st->epSquares &= legalEpSquares;
+  while (invalidEpSquares)
+      st->key ^= Zobrist::enpassant[file_of(pop_lsb(invalidEpSquares))];
+}
+
+
+/// Position::drawless_policy_terminal() recognizes the two material-topology
+/// terminals that an otherwise quiet or selectively pruned move can create.
+
+bool Position::drawless_policy_terminal() const {
+  if (!uses_drawless_rules_v1())
+      return false;
+
+  const bool bareKing =
+      Options["Drawless Bare King"] == "bare-king-loses"
+      && ((drawless_material(WHITE) == 0 && drawless_material(BLACK) > 0)
+          || (drawless_material(BLACK) == 0 && drawless_material(WHITE) > 0));
+
+  return bareKing || drawless_known_dead_position();
+}
+
+
+/// Position::drawless_policy_terminal_move_candidate() is a cheap necessary-
+/// condition gate for the exact do/undo classifier used by search. It is
+/// deliberately conservative: false must mean that no single orthodox move
+/// can create bare-king or known-dead material, while true is only a request
+/// for exact classification of the legal moves.
+
+bool Position::drawless_policy_terminal_move_candidate() const {
+  if (!uses_drawless_rules_v1())
+      return false;
+
+  const int opposingNonKings = count<PAWN>(~sideToMove)
+                             + count<KNIGHT>(~sideToMove)
+                             + count<BISHOP>(~sideToMove)
+                             + count<ROOK>(~sideToMove)
+                             + count<QUEEN>(~sideToMove);
+  const bool bareCandidate =
+      Options["Drawless Bare King"] == "bare-king-loses"
+      && opposingNonKings == 1;
+
+  const int blockers = count<PAWN>() + count<ROOK>() + count<QUEEN>();
+  const int nonKings = blockers + count<KNIGHT>() + count<BISHOP>();
+  const bool deadCandidate = blockers <= 2
+                          && (nonKings <= 2 || count<KNIGHT>() <= 1);
+
+  return bareCandidate || deadCandidate;
+}
+
