-      if (stp->capturedPiece)
-          return mover;
+  // A null frame copies capturedPiece but is not a real move. Ignore both the
+  // copied capture and its synthetic turn: real moves immediately before and
+  // after a skipped null turn belong to the same inferred mover.
+  Color mover = st->pliesFromNull == 0 ? sideToMove : ~sideToMove;
+  for (const StateInfo* stp = st; stp && stp->previous; )
+  {
+      const StateInfo* previous = stp->previous;
+      if (stp->pliesFromNull != 0)
+      {
+          if (stp->capturedPiece)
+              return mover;
+          if (previous->pliesFromNull != 0)
+              mover = ~mover;
+      }
+      stp = previous;
+  }
 
   return COLOR_NB;
 }
