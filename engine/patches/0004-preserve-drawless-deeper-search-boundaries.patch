+  // Exact, reversible classification is required here: material counts alone
+  // cannot tell whether a capture or a quiet underpromotion creates the
+  // configured bare-king/known-dead terminal.
+  bool creates_drawless_policy_terminal(Position& pos, Move move) {
+    StateInfo st;
+    ASSERT_ALIGNED(&st, Eval::NNUE::CacheLineSize);
+
+    pos.do_drawless_probe_move(move, st);
+    const bool terminal = pos.drawless_policy_terminal();
+    pos.undo_move(move);
+    return terminal;
+  }
+
+  bool creates_drawless_immediate_terminal(Position& pos, Move move) {
+    StateInfo st;
+    ASSERT_ALIGNED(&st, Eval::NNUE::CacheLineSize);
+
+    pos.do_drawless_probe_move(move, st);
+    Value result;
+    const bool terminal = pos.is_game_end(result) || !pos.has_legal_move();
+    pos.undo_move(move);
+    return terminal;
+  }
+
+  bool creates_drawless_no_legal_terminal(Position& pos, Move move) {
+    StateInfo st;
+    ASSERT_ALIGNED(&st, Eval::NNUE::CacheLineSize);
+
+    pos.do_drawless_probe_move(move, st);
+    const bool terminal = !pos.has_legal_move();
+    pos.undo_move(move);
+    return terminal;
+  }
+
+  bool has_drawless_no_legal_terminal_move(Position& pos) {
+    for (Move move : MoveList<LEGAL>(pos))
+        if (creates_drawless_no_legal_terminal(pos, move))
+            return true;
+
+    return false;
+  }
+
+  bool has_drawless_policy_terminal_move(Position& pos) {
+    if (!pos.drawless_policy_terminal_move_candidate())
+        return false;
+
+    for (Move move : MoveList<LEGAL>(pos))
+        if (creates_drawless_policy_terminal(pos, move))
+            return true;
+
+    return false;
+  }
