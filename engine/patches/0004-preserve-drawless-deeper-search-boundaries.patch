+/// Position::do_drawless_probe_move() makes a reversible classification move
+/// without charging it as a searched node. Drawless policy probes may inspect
+/// every legal sibling before the real search; counting those speculative
+/// makes would inflate NPS and make a `go nodes` limit stop early.
+
+void Position::do_drawless_probe_move(Move m, StateInfo& newSt) {
+
+  do_move(m, newSt);
+
+#ifndef NO_THREADS
+  thisThread->nodes.fetch_sub(1, std::memory_order_relaxed);
+#endif
+}
