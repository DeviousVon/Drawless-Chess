+/// Position::has_legal_move() answers the common terminal query without
+/// constructing and compacting a complete LEGAL list. Pseudo moves are still
+/// generated in bulk, but legality checking stops at the first playable move.
+
+bool Position::has_legal_move() const {
+  if (is_immediate_game_end())
+      return false;
+
+  if (checkers())
+  {
+      for (Move move : MoveList<EVASIONS>(*this))
+          if (!virtual_drop(move) && legal(move))
+              return true;
+  }
+  else
+      for (Move move : MoveList<NON_EVASIONS>(*this))
+          if (!virtual_drop(move) && legal(move))
+              return true;
+
+  return false;
+}
