{
  "name": "drawless-chess-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build && vite build --config vite.play.config.ts",
    "start": "vinext start",
    "prepare:openbsd": "node scripts/prepare-openbsd-release.mjs dist/client release",
    "verify:openbsd": "node scripts/verify-openbsd-release.mjs release --route / --route /play/ --route /privacy/ --route /support/ --route /open-source/",
    "verify:storefronts": "node scripts/verify-storefronts.mjs",
    "audit": "pnpm audit --ignore GHSA-w3rx-r6r6-pgpr --ignore GHSA-5p2g-fcmc-qvqq",
    "audit:prod": "pnpm audit --prod",
    "audit:raw": "pnpm audit",
    "test": "pnpm run audit:prod && pnpm run audit && pnpm run build && pnpm run prepare:openbsd && pnpm run verify:openbsd && node --test tests/rendered-html.test.mjs && node --test tests/serve-static.test.mjs && node --experimental-strip-types --test tests/play-rules.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern release --ignore-pattern .next"
  },
  "dependencies": {
    "ffish-es6": "0.7.9",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.1",
    "react-server-dom-webpack": "19.2.8",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.1",
    "wrangler": "4.124.0"
  },
  "type": "module"
}
